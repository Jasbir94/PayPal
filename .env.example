# PostgreSQL stores wallet, payment, feedback, and audit data.
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SHIELD_CORS_ORIGINS=http://127.0.0.1:5173
# Optional; keep server-side and rotate if exposed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_SHIELD_DEMO_BALANCE_U101=10000
APP_SHIELD_DEMO_BALANCE_U102=2000
APP_SHIELD_DEMO_BALANCE_U103=10000
