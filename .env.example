# SQLite for local work; application reads DATABASE_URL from the environment.
DATABASE_URL=sqlite:///./app_shield.db
# PostgreSQL alternative: postgresql+psycopg://user:password@localhost/app_shield
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SHIELD_CORS_ORIGINS=http://127.0.0.1:5173
APP_SHIELD_FEEDBACK_DB=data/processed/day9/feedback.sqlite
# Demo wallet ledger (set these in the process environment; .env is documentation only).
APP_SHIELD_BANKING_DB=data/processed/demo_banking.sqlite3
APP_SHIELD_DEMO_BALANCE_U101=10000
APP_SHIELD_DEMO_BALANCE_U102=2000
APP_SHIELD_DEMO_BALANCE_U103=10000
